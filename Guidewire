from typing import Annotated
from typing_extensions import TypedDict

from langchain_core.messages import HumanMessage, ToolMessage
from langchain_core.tools import tool
from langchain_openai import ChatOpenAI

from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages


# ============================================================
# 1. TOOL
# ============================================================

@tool
def calculator(expression: str) -> str:
    """Calculate a mathematical expression."""
    return str(eval(expression))


# ============================================================
# 2. LLM
# ============================================================

llm = ChatOpenAI(
    model="your-model-name",
    temperature=0
)

# Tell the LLM which tools it is allowed to request
llm_with_tools = llm.bind_tools([calculator])


# ============================================================
# 3. GRAPH STATE
# ============================================================

class State(TypedDict):
    messages: Annotated[list, add_messages]


# ============================================================
# 4. LLM NODE
# ============================================================

def call_llm(state: State):
    response = llm_with_tools.invoke(
        state["messages"]
    )

    return {
        "messages": [response]
    }


# ============================================================
# 5. MANUAL TOOL NODE
# ============================================================

def call_tool(state: State):

    # Get the latest AI message
    last_message = state["messages"][-1]

    # Get the tool call requested by the LLM
    tool_call = last_message.tool_calls[0]

    # Execute the requested tool
    result = calculator.invoke(
        tool_call["args"]
    )

    # Return the tool result as a ToolMessage
    return {
        "messages": [
            ToolMessage(
                content=result,
                tool_call_id=tool_call["id"]
            )
        ]
    }


# ============================================================
# 6. ROUTER
# ============================================================

def should_continue(state: State):

    last_message = state["messages"][-1]

    # If LLM requested a tool → go to tool node
    if last_message.tool_calls:
        return "tool"

    # Otherwise → finish
    return "end"


# ============================================================
# 7. BUILD GRAPH
# ============================================================

builder = StateGraph(State)

builder.add_node("llm", call_llm)
builder.add_node("tool", call_tool)

builder.add_edge(
    START,
    "llm"
)

builder.add_conditional_edges(
    "llm",
    should_continue,
    {
        "tool": "tool",
        "end": END
    }
)

# After tool execution, go back to the LLM
builder.add_edge(
    "tool",
    "llm"
)


# ============================================================
# 8. COMPILE
# ============================================================

graph = builder.compile()


# ============================================================
# 9. RUN
# ============================================================

result = graph.invoke({
    "messages": [
        HumanMessage(
            content="What is 25 * 4?"
        )
    ]
})


# ============================================================
# 10. FINAL RESPONSE
# ============================================================

print(result["messages"][-1].content)



