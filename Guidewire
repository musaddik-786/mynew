def is_expert_double_booked(cur, expert_id: str, scheduled_date: date, scheduled_time: str) -> bool:
   """
   True if this expert already has an active work order at this date/time.
   work_orders.scheduled_date is stored as TEXT in the current schema,
   so compare using the ISO string representation.
   """
   cur.execute(
       """
       SELECT 1
       FROM work_orders
       WHERE expert_id = %s
         AND scheduled_date = %s
         AND scheduled_time = %s
         AND status = ANY(%s)
       LIMIT 1
       """,
       (
           expert_id,
           scheduled_date.isoformat(),   # <-- convert DATE to TEXT
           scheduled_time,
           list(ACTIVE_STATUSES),
       ),
   )
   return cur.fetchone() is not None









