from langgraph.graph import StateGraph, START, END
from langgraph.prebuilt import ToolNode
from typing_extensions import Annotated
from langgraph.graph.message import add_messages
from langchain_core.messages import AIMessage, ToolMessage

# -----------------------
# STATE
# -----------------------
class State(dict):
   messages: Annotated[list, add_messages]

# -----------------------
# TOOL (normal Python function)
# -----------------------
def get_weather(city: str):
   """Returns the current weather for a given city"""
   return f"The weather in {city} is sunny"

# -----------------------
# AGENT (FAKE AI)
# -----------------------
def agent(state):
   if len(state["messages"]) == 0:
       return {
           "messages": [
               AIMessage(
                   content="",
                   tool_calls=[{
                       "name": "get_weather",
                       "args": {"city": "Delhi"},
                       "id": "call_1"
                   }]
               )
           ]
       }
   else:
       return {"messages": ["Agent: Got tool result, End"]}

# -----------------------
# ROUTER
# -----------------------
def router(state):
   last = state["messages"][-1]
   if isinstance(last, AIMessage) and last.tool_calls:
       return "tools"
   return "end"

# -----------------------
# GRAPH
# -----------------------
graph = StateGraph(State)
graph.add_node("agent", agent)
graph.add_node("tools", ToolNode(tools=[get_weather]))
graph.add_edge(START, "agent")
graph.add_conditional_edges(
   "agent",
   router,
   {
       "tools": "tools",
       "end": END
   }
)
graph.add_edge("tools", "agent")
graph = graph.compile()

print("\n--- stream() ---")
for step in graph.stream({"messages": []}):
   print(step)

print("\n--- invoke() ---")

# final_result = graph.invoke({"messages": []})

print(graph.invoke({"messages": []}))





