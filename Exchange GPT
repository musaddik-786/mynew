def match_layout_type(raw_layout: str, db_types: list) -> str:
    """
    Match the LLM-generated layout type against the canonical
    document_type values stored in the database.

    Matching priority:

    1. Exact normalized match
    2. Canonical DB value contained inside the LLM layout
    3. Existing fuzzy matching
    4. If nothing is confident enough, return raw LLM value
    """

    if not raw_layout:
        return raw_layout

    if not db_types:
        logger.warning(
            "No document types available from DB. "
            "Returning raw layout: '%s'",
            raw_layout
        )
        return raw_layout

    raw_norm = _normalize(raw_layout)

    # ---------------------------------------------------------
    # 1. EXACT MATCH
    # ---------------------------------------------------------
    for dt in db_types:

        if not dt:
            continue

        dt_norm = _normalize(dt)

        if raw_norm == dt_norm:

            logger.info(
                "Exact layout match: '%s' -> '%s'",
                raw_layout,
                dt
            )

            return dt

    # ---------------------------------------------------------
    # 2. CANONICAL DB VALUE IS CONTAINED IN LLM OUTPUT
    #
    # Example:
    #
    # LLM:
    # MRC_Slip_Credit_and_Political_Risk
    #
    # DB:
    # MRC_Slip
    #
    # Result:
    # MRC_Slip
    # ---------------------------------------------------------
    containment_matches = []

    for dt in db_types:

        if not dt:
            continue

        dt_norm = _normalize(dt)

        if dt_norm in raw_norm:

            containment_matches.append(
                (len(dt_norm), dt)
            )

    if containment_matches:

        # If multiple DB values are contained,
        # prefer the longest / most specific one.
        containment_matches.sort(
            key=lambda x: x[0],
            reverse=True
        )

        best_match = containment_matches[0][1]

        logger.info(
            "Canonical containment match: '%s' -> '%s'",
            raw_layout,
            best_match
        )

        return best_match

    # ---------------------------------------------------------
    # 3. EXISTING FUZZY MATCHING
    # ---------------------------------------------------------
    best_match = None
    best_score = 0.0

    for dt in db_types:

        if not dt:
            continue

        dt_norm = _normalize(dt)

        score = _score(
            raw_norm,
            dt_norm
        )

        logger.debug(
            "Score '%s' vs '%s' = %.2f",
            raw_layout,
            dt,
            score
        )

        if score > best_score:

            best_score = score
            best_match = dt

    # ---------------------------------------------------------
    # 4. CONFIDENT FUZZY MATCH
    # ---------------------------------------------------------
    if best_match and best_score >= MATCH_THRESHOLD:

        logger.info(
            "Fuzzy layout match: '%s' -> '%s' (score=%.2f)",
            raw_layout,
            best_match,
            best_score
        )

        return best_match

    # ---------------------------------------------------------
    # 5. NO MATCH
    # ---------------------------------------------------------
    logger.warning(
        "No confident match for layout '%s' "
        "(best='%s', score=%.2f), using raw value",
        raw_layout,
        best_match,
        best_score
    )

    return raw_layout
