    #     "text_blob_url": text_blob_url,
    #     # "output_blob_url": output_blob_url
    # }

    result= {
        "status": True,
        "lob": lob,
        "layout_type": layout_type,
        "matched_document_type": matched_document_type,
        "URL": text_blob_url,
        "text_blob_url": text_blob_url,
        # "output_blob_url": output_blob_url
    }
    try:
            output_blob_url = await upload_layout_document_output(
            text_blob_url,
            result
            )
            result["output_blob_url"] = output_blob_url
            logger.info(
            "Final layout classification uploaded: %s",
            output_blob_url
            )
    except Exception as e:
        logger.error(
            "Failed to upload layout classification output: %s",
            e
        )
        return {
            "status": False,
            "error": f"Failed to upload layout classification output: {e}"
        }
       
        
