logger = logging.getLogger(__name__)

MATCH_THRESHOLD = 0.5
MIN_CHUNK_LEN = 2


def fetch_document_types_from_db() -> list:
    try:
        conn = psycopg2.connect(
            host=os.getenv("PGHOST_PROMPT"),
            port=int(os.getenv("PGPORT_PROMPT", "5432")),
            database=os.getenv("PGDATABASE_PROMPT"),
            user=os.getenv("PGUSER_PROMPT"),
            password=os.getenv("PGPASSWORD_PROMPT"),
        )
        with conn.cursor() as cur:
            cur.execute("SELECT DISTINCT document_type FROM ref_prompt_library WHERE document_type IS NOT NULL")
            rows = cur.fetchall()
        conn.close()
        return [row[0] for row in rows]
    except Exception as e:
        logger.warning("Could not fetch document types from DB: %s", e)
        return []


def _normalize(value: str) -> str:
    """Strip separators and uppercase for clean comparison."""
    return re.sub(r"[_\-\s]+", "", value.upper())


def _coverage_score(raw: str, db_type: str, reverse: bool = False) -> float:
    """
    Greedy scan of raw (left-to-right or right-to-left) finding non-overlapping
    substrings of length >= MIN_CHUNK_LEN that exist anywhere in db_type.
    Score = total matched chars / len(raw).
    """
    if not raw or not db_type:
        return 0.0

    chars = list(raw) if not reverse else list(reversed(raw))
    joined = "".join(chars)

    matched = 0
    i = 0
    while i < len(joined):
        found = False
        for length in range(len(joined) - i, MIN_CHUNK_LEN - 1, -1):
            chunk = joined[i:i + length]
            if chunk in db_type:
                matched += length
                i += length
                found = True
                break
        if not found:
            i += 1

    return matched / len(raw)


def _score(raw: str, db_type: str) -> float:
    """
    Combine three scoring strategies and return the highest:
      1. SequenceMatcher  — handles in-order partial/truncated matches
      2. Coverage LTR     — handles out-of-order abbreviations, left to right
      3. Coverage RTL     — same scan but right to left
    """
    if not raw or not db_type:
        return 0.0

    seq   = SequenceMatcher(None, raw, db_type).ratio()
    c_ltr = _coverage_score(raw, db_type, reverse=False)
    c_rtl = _coverage_score(raw, db_type, reverse=True)

    return max(seq, c_ltr, c_rtl)


def match_layout_type(raw_layout: str, db_types: list) -> str:
    if not db_types:
        return raw_layout

    raw_norm = _normalize(raw_layout)

    best_match = None
    best_score = 0.0

    for dt in db_types:
        dt_norm = _normalize(dt)
        score = _score(raw_norm, dt_norm)
        logger.debug("Score '%s' vs '%s' = %.2f", raw_layout, dt, score)
        if score > best_score:
            best_score = score
            best_match = dt

    if best_match and best_score >= MATCH_THRESHOLD:
        logger.info(
            "Layout '%s' matched to '%s' (score=%.2f)",
            raw_layout, best_match, best_score
        )
        return best_match

    logger.warning(
        "No confident match for layout '%s' (best score=%.2f), using raw value",
        raw_layout, best_score
    )
    return raw_layout




