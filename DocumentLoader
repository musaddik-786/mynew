import os
import logging
import aiofiles
from azure.storage.blob.aio import BlobServiceClient
from azure.core.exceptions import ResourceNotFoundError, ResourceExistsError
from .service import AZURE_STORAGE_CONNECTION_STRING, _parse_blob_url
from urllib.parse import urlparse

logger = logging.getLogger(__name__)

TEXT_CONTAINER = "layout-detection-text-of-document"


async def download_blob_bytes(blob_url: str):
   container, blob_path = _parse_blob_url(blob_url)
   async with BlobServiceClient.from_connection_string(
       AZURE_STORAGE_CONNECTION_STRING
   ) as service:
       container_client = service.get_container_client(container)
       blob_client = container_client.get_blob_client(blob_path)
       try:
           await blob_client.get_blob_properties()
       except ResourceNotFoundError:
           raise FileNotFoundError("Blob not found")
       stream = await blob_client.download_blob()
       data = await stream.readall()
   return data


async def upload_text_to_blob(blob_url: str, text: str):
   parsed = urlparse(blob_url)
   path = parsed.path.lstrip("/")
   container, blob_path = path.split("/", 1)
   filename = os.path.basename(blob_path)
   base_name = os.path.splitext(filename)[0]
   new_blob_name = f"{base_name}.txt"
   async with BlobServiceClient.from_connection_string(
       AZURE_STORAGE_CONNECTION_STRING
   ) as blob_service:
       # create container if not exists
       container_client = blob_service.get_container_client(TEXT_CONTAINER)
       try:
           await container_client.create_container()
       except ResourceExistsError:
           pass
       blob_client = container_client.get_blob_client(new_blob_name)
       await blob_client.upload_blob(text, overwrite=True)
   return f"{parsed.scheme}://{parsed.netloc}/{TEXT_CONTAINER}/{new_blob_name}"


async def read_text_blob(text_blob_url: str) -> str:
   """
   NEW: Read a text blob DIRECTLY from Azure Blob Storage into memory,
   for the new lob + text_blob_url flow. The upstream LOB Detection MCP
   already stores raw extracted text in Blob Storage, so this deliberately
   does NOT write anything to local disk - it just downloads the blob
   bytes and decodes them.

   Reuses the same AZURE_STORAGE_CONNECTION_STRING / _parse_blob_url
   helpers as the rest of this module rather than duplicating storage
   connection logic.
   """
   container, blob_path = _parse_blob_url(text_blob_url)
   async with BlobServiceClient.from_connection_string(
       AZURE_STORAGE_CONNECTION_STRING
   ) as service:
       container_client = service.get_container_client(container)
       blob_client = container_client.get_blob_client(blob_path)
       try:
           await blob_client.get_blob_properties()
       except ResourceNotFoundError:
           raise FileNotFoundError(
               f"Text blob not found: container={container} blob={blob_path}"
           )
       stream = await blob_client.download_blob()
       data = await stream.readall()

   try:
       return data.decode("utf-8")
   except UnicodeDecodeError:
       return data.decode("latin-1")




