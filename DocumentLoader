import os
from urllib.parse import urlparse, unquote
from dotenv import load_dotenv

load_dotenv()

AZURE_STORAGE_CONNECTION_STRING = os.environ.get("AZURE_STORAGE_CONNECTION_STRING", "")

def _require_env() -> None:
    """Ensure required environment variables exist."""
    if not AZURE_STORAGE_CONNECTION_STRING:
        raise RuntimeError("Missing AZURE_STORAGE_CONNECTION_STRING in environment/.env")

def _parse_blob_url(url: str) -> tuple[str, str]:
    """
    Parse an Azure Blob URL and return (container_name, blob_path).
    Example URL:
      https://account.blob.core.windows.net/output-results/folder/name.pdf
    Returns:
      ("output-results", "folder/name.pdf")
    """
    parsed = urlparse(url)
    if not parsed.scheme.startswith("http"):
        raise ValueError("url must be a valid http(s) Azure Blob URL.")

    path = parsed.path.lstrip("/")
    if "/" not in path:
        raise ValueError("url must include both container and blob path.")
    parts = path.split("/", 1)
    container = parts[0]
    blob_path = parts[1]
    return unquote(container), unquote(blob_path)





import io
import logging
from dotenv import load_dotenv
import os

from azure.ai.formrecognizer import DocumentAnalysisClient
from azure.core.credentials import AzureKeyCredential

import mammoth
from weasyprint import HTML

logger = logging.getLogger(__name__)

load_dotenv()

endpoint = os.getenv("LD_AZURE_FORMRECOG_ENDPOINT")
key = os.getenv("LD_AZURE_FORMRECOG_KEY")

client = DocumentAnalysisClient(
    endpoint=endpoint,
    credential=AzureKeyCredential(key)
)


def convert_docx_bytes_to_pdf_bytes(docx_bytes: bytes):
    docx_stream = io.BytesIO(docx_bytes)

    html = mammoth.convert_to_html(docx_stream).value

    pdf_bytes = HTML(string=html).write_pdf()

    return pdf_bytes


async def load_pdf_document(blob_url: str, file_bytes: bytes):
    """
    Existing PDF/DOCX processing logic using Form Recognizer.
    """

    extension = blob_url.split(".")[-1].lower()

    logger.info(
        " Analysing document: extension=%s size=%d bytes",
        extension,
        len(file_bytes)
    )

    if extension == "docx":
        logger.info(" Converting DOCX → PDF")
        file_bytes = convert_docx_bytes_to_pdf_bytes(file_bytes)

    logger.info(" Sending to Azure Form Recognizer (prebuilt-read)")

    poller = client.begin_analyze_document(
        "prebuilt-read",
        document=file_bytes
    )

    result = poller.result()

    lines = [
        line.content
        for page in result.pages
        for line in page.lines
    ]

    logger.info(
        "Form Recognizer complete: %d pages, %d lines extracted",
        len(result.pages),
        len(lines)
    )

    return {
        "text": "\n".join(lines)
    }


async def load_text_document(file_bytes: bytes):
    """
    Load plain text file directly without Form Recognizer.
    """

    logger.info(" Processing TXT file")

    try:
        extracted_text = file_bytes.decode("utf-8")
    except UnicodeDecodeError:
        extracted_text = file_bytes.decode("latin-1")

    logger.info(
        " TXT file processed successfully: %d chars extracted",
        len(extracted_text)
    )

    return {
        "text": extracted_text
    }


async def load_document_from_bytes(blob_url: str, file_bytes: bytes):
    """
    Main dispatcher function.
    Decides which loader to use.
    """

    extension = blob_url.split(".")[-1].lower()

    if extension in ["pdf", "docx"]:
        return await load_pdf_document(blob_url, file_bytes)

    elif extension == "txt":
        return await load_text_document(file_bytes)

    else:
        raise ValueError(
            f"Unsupported file type: {extension}. "
            f"Supported types are pdf, docx, txt"
        )







