import os
import json
import logging
from typing import Dict, Any

from service import _require_env

logger = logging.getLogger(__name__)

from storage_utils import (
    download_blob_bytes,
    upload_text_to_blob,
    read_text_blob,
)

from document_loader import load_document_from_bytes

from classifier import (
    classify_document,
    classify_document_legacy,
    UnsupportedLOBError,
    SUPPORTED_LOBS,
)
from prompt_library_matcher import fetch_document_types_from_db, match_layout_type


# ---------------------------------------------------------------------------
# EXISTING (legacy) FLOW - unchanged behaviour.
# blob_url (pdf/docx/txt) -> download -> Form Recognizer / TXT loader ->
# classify -> upload extracted text -> fuzzy match -> response.
#
# Only change: calls classify_document_legacy() instead of classify_document(),
# because classify_document() now requires a `lob` argument. This preserves
# the exact original prompt/behaviour for this path.
# ---------------------------------------------------------------------------
async def classify_blob_pdf_layout(blob_url: str) -> Dict[str, Any]:

    logger.info(
        " classify_blob_pdf_layout invoked: blob_url=%s",
        blob_url
    )

    try:
        blob_bytes = await download_blob_bytes(blob_url)

        logger.info(
            "Blob downloaded: %d bytes | url=%s",
            len(blob_bytes),
            blob_url
        )

    except Exception as e:

        logger.error(
            " Failed to fetch blob: %s | url=%s",
            e,
            blob_url
        )

        return {
            "status": False,
            "error": f"Failed to fetch blob: {e}"
        }

    try:

        document_content = await load_document_from_bytes(
            blob_url,
            blob_bytes
        )

        char_count = len(document_content.get("text", ""))

        logger.info(
            " Document parsed: %d chars extracted | url=%s",
            char_count,
            blob_url
        )

    except Exception as e:

        logger.error(
            " Document parsing failed: %s | url=%s",
            e,
            blob_url
        )

        return {
            "status": False,
            "error": f"Document parsing failed: {e}"
        }

    extracted_text = document_content.get("text", "")

    try:

        text_blob_url = await upload_text_to_blob(
            blob_url,
            extracted_text
        )

        logger.info(
            "Extracted text uploaded: %s",
            text_blob_url
        )

    except Exception as e:

        logger.error(
            " Failed to upload extracted text: %s | url=%s",
            e,
            blob_url
        )

        return {
            "status": False,
            "error": f"Failed to upload extracted text: {e}"
        }

    try:

        layout_type = classify_document_legacy(document_content)

        logger.info(
            " Classification complete: layout_type=%s | url=%s",
            layout_type,
            blob_url
        )

    except Exception as e:

        logger.error(
            " Classification failed: %s | url=%s",
            e,
            blob_url
        )

        return {
            "status": False,
            "error": f"Classification failed: {e}"
        }

    db_types = fetch_document_types_from_db()
    matched_document_type = match_layout_type(layout_type, db_types)

    return {
        "status": True,
        "layout_type": layout_type,
        "matched_document_type": matched_document_type,
        "URL": blob_url,
        "text_blob_url": text_blob_url
    }


# ---------------------------------------------------------------------------
# NEW FLOW - receives LOB + text_blob_url from the upstream LOB Detection
# MCP. Reads the raw text directly from Blob Storage in memory (no local
# TXT file, no Form Recognizer reprocessing), classifies using the
# LOB-specific Phoenix prompt, then runs the EXISTING, unchanged fuzzy
# matcher (fetch_document_types_from_db + match_layout_type).
# ---------------------------------------------------------------------------
async def classify_lob_text_layout(lob: str, text_blob_url: str) -> Dict[str, Any]:

    logger.info(
        " classify_lob_text_layout invoked: lob=%s, text_blob_url=%s",
        lob,
        text_blob_url
    )

    # 1. Missing LOB
    if not lob:
        return {"status": False, "error": "Missing 'lob' in request."}

    # 2. Unsupported LOB
    if lob not in SUPPORTED_LOBS:
        return {
            "status": False,
            "error": f"Unsupported LOB '{lob}'. Supported values are: {SUPPORTED_LOBS}"
        }

    # 3. Missing text_blob_url
    if not text_blob_url:
        return {"status": False, "error": "Missing 'text_blob_url' in request."}

    # 4. Blob cannot be read
    try:
        text = await read_text_blob(text_blob_url)

        logger.info(
            "Text blob read: %d chars | lob=%s | url=%s",
            len(text or ""),
            lob,
            text_blob_url
        )

    except Exception as e:
        logger.error(
            " Failed to read text blob: %s | lob=%s | url=%s",
            e,
            lob,
            text_blob_url
        )
        return {"status": False, "error": f"Failed to read text blob: {e}"}

    # 5. Empty text
    if not text or not text.strip():
        logger.error(" Text blob is empty | lob=%s | url=%s", lob, text_blob_url)
        return {"status": False, "error": "Text blob is empty."}

    # 6. Phoenix prompt mapping missing / 7. Azure OpenAI failure / 8. Classification failure
    try:
        layout_type = classify_document(text=text, lob=lob)

        logger.info(
            " Classification complete: layout_type=%s | lob=%s | url=%s",
            layout_type,
            lob,
            text_blob_url
        )

    except UnsupportedLOBError as e:
        logger.error(" Phoenix prompt mapping missing: %s", e)
        return {"status": False, "error": str(e)}

    except Exception as e:
        logger.error(
            " Classification failed: %s | lob=%s | url=%s",
            e,
            lob,
            text_blob_url
        )
        return {"status": False, "error": f"Classification failed: {e}"}

    # 9. DB fuzzy matching failure
    try:
        db_types = fetch_document_types_from_db()
        matched_document_type = match_layout_type(layout_type, db_types)
    except Exception as e:
        logger.error(" DB fuzzy matching failed: %s", e)
        return {"status": False, "error": f"DB fuzzy matching failed: {e}"}

    return {
        "status": True,
        "lob": lob,
        "layout_type": layout_type,
        "matched_document_type": matched_document_type,
        "URL": text_blob_url,
        "text_blob_url": text_blob_url
    }



