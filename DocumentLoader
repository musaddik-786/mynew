)

# ---------------------------------------------------------------------------
# LOB -> Phoenix prompt version mapping.
#
# >>> INSERT THE FIVE ACTUAL PHOENIX PROMPT VERSION IDs HERE. <<<
#
# Each LOB gets its own Phoenix prompt containing only the layout types
# relevant to that LOB, so the LLM never has to consider unrelated
# categories from other lines of business.
# ---------------------------------------------------------------------------
PHOENIX_PROMPTS = {
    "Commercial Property": "REPLACE_WITH_COMMERCIAL_PROPERTY_PROMPT_VERSION",
    "General Liability": "REPLACE_WITH_GENERAL_LIABILITY_PROMPT_VERSION",
    "Credit and Political Risk": "REPLACE_WITH_CREDIT_POLITICAL_RISK_PROMPT_VERSION",
    "Home Owners": "REPLACE_WITH_HOME_OWNERS_PROMPT_VERSION",
    "Life": "REPLACE_WITH_LIFE_PROMPT_VERSION",
}

SUPPORTED_LOBS = list(PHOENIX_PROMPTS.keys())

# The original code used max_tokens=4, which truncates longer canonical
# layout names (e.g. "Property_Detailed_Report", "MLPUKSUBMISSION").
# Raised to safely fit the longest allowed enum value while still keeping
# the model constrained to a single short output.
CLASSIFICATION_MAX_TOKENS = 32

# Kept for the legacy (non-LOB) calling path only - this was the single
# hardcoded Phoenix prompt version used before LOB-specific prompts existed.
LEGACY_PROMPT_VERSION = "UHJvbXB0VmVyc2lvbjo4NQ=="


class UnsupportedLOBError(ValueError):
    """Raised when a LOB value has no configured Phoenix prompt mapping."""
    pass


def _call_llm(prompt: str) -> str:
    response = client.chat.completions.create(
        model=AZURE_OPENAI_CHAT_DEPLOYMENT,
        messages=[{"role": "user", "content": prompt}],
        max_tokens=CLASSIFICATION_MAX_TOKENS,
        temperature=0.0
    )

    try:
        layout_type = response.choices[0].message.content.strip()
    except Exception as e:
        logger.warning("Failed to access message content via attribute, falling back: %s", e)
        layout_type = getattr(response.choices[0].message, "content", "").strip()

    return layout_type


def classify_document(text: str, lob: str) -> str:
    """
    NEW: LOB-aware classification entry point.

    Selects the Phoenix prompt for the given LOB (so the LLM only sees
    layout types relevant to that LOB), sends the document text to
    Azure OpenAI, and returns the raw layout_type string.

    Used by the new lob + text_blob_url flow (handler.classify_lob_text_layout).
    """
    if lob not in PHOENIX_PROMPTS:
        raise UnsupportedLOBError(
            f"Unsupported LOB '{lob}'. Supported values are: {SUPPORTED_LOBS}"
        )

    prompt_version = PHOENIX_PROMPTS[lob]

    logger.info(
        "🔎 classify_document called: lob=%s, %d chars of text",
        lob, len(text or "")
    )

    # Bug fix: the original code did `text_new = {text[:2000]}`, which
    # creates a Python SET instead of a string. Fixed to a plain slice.
    text_new = text[:2000]

    prompt = build_prompt(
        prompt_version,
        text_new=text_new,
    )

    logger.info("🤖 Calling LLM for document classification (lob=%s)", lob)
    layout_type = _call_llm(prompt)

    logger.info("🏷️ Document classified as: %s (lob=%s)", layout_type, lob)
    return layout_type


def classify_document_legacy(document_content: dict) -> str:
    """
    BACKWARD-COMPATIBLE: preserves the OLD calling convention
    (classify_document(document_content)) for the legacy PDF/DOCX/TXT
    blob-URL flow, which has no LOB. Uses the single prompt version that
    was previously hardcoded in this module.

    Only used by handler.classify_blob_pdf_layout (the old path).
    """
    text = document_content.get("text", "")
    logger.info("🔎 classify_document_legacy called: %d chars of text", len(text))

    # Same bug fix applied here.
    text_new = text[:2000]

    prompt = build_prompt(
        LEGACY_PROMPT_VERSION,
        text_new=text_new,
    )

    logger.info("🤖 Calling LLM for document classification (legacy path)")
    layout_type = _call_llm(prompt)

    logger.info("🏷️ Document classified as: %s (legacy path)", layout_type)
    return layout_type




