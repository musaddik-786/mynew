"""
validation.py — Dispatch
─────────────────────────
Shared validation helpers for the Dispatch MCP. PostgreSQL is always the
source of truth for claims, experts, and work-order state; nothing here
trusts caller/LLM-supplied IDs or master data.

Every query here references only columns confirmed to exist:

  claims:        id, claim_number, policy_number, policyholder_name,
                  loss_type, location, status, assigned_adjuster,
                  assigned_vendor, created_at, updated_at
  experts:       expert_id, name, expert_type, email, phone, active
                  (active is a BOOLEAN column — experts are enabled/disabled
                  via this flag, confirmed against the live database; there
                  is no experts.status column)
  work_orders:   id, work_order_id, claim_id, claim_number, expert_id,
                  expert_name, expert_type, scheduled_date, scheduled_time,
                  estimated_arrival, estimated_cost, status, priority,
                  notes_to_expert, customer_address, customer_phone,
                  customer_email, assigned_by, started_at, completed_at,
                  canceled_at, cancel_reason, created_at, updated_at
  dispatch_logs: id, log_id, work_order_id, claim_id, action, action_by,
                  details, previous_status, new_status, created_at

No other columns or tables are referenced.

NotFoundError   -> caller should translate to HTTP 404 (missing claim/
                   expert/work order).
ValidationError -> caller should translate to HTTP 400 (bad input, invalid
                   state transition, duplicate/conflicting booking, etc.).
"""

import os
import random
import sys
from datetime import date, datetime
from typing import Optional

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "common"))

from db import row_to_dict  # noqa: E402

VALID_STATUSES = ("Scheduled", "In Progress", "Completed", "Canceled")
VALID_PRIORITIES = ("Low", "Normal", "High")
ACTIVE_STATUSES = ("Scheduled", "In Progress")

# Allowed forward transitions. Canceled and Completed are terminal.
ALLOWED_TRANSITIONS = {
    "Scheduled": {"In Progress", "Canceled"},
    "In Progress": {"Completed", "Canceled"},
    "Completed": set(),
    "Canceled": set(),
}

# scheduled_date is treated strictly as a calendar date. We accept a couple
# of common input encodings but always compare/store as a real date object
# — never as a string.
_DATE_FORMATS = ("%Y-%m-%d", "%m/%d/%Y")

# scheduled_time is parsed (not regex-matched) so "25:00" / "99:88" / "abcd"
# are all rejected by datetime.strptime rather than a hand-rolled pattern.
# Both 24-hour ("14:30") and 12-hour with AM/PM ("10:30 AM", "02:45 PM") are
# accepted, since that's what the LLM naturally produces. Whatever format
# matches, the value is normalized to "HH:MM:SS" (24-hour) before it's
# stored or compared, so double-booking checks never miss a match just
# because one caller sent "2:00 PM" and another sent "14:00".
_TIME_FORMATS = ("%H:%M", "%H:%M:%S", "%I:%M %p", "%I:%M:%S %p")
_TIME_STORAGE_FORMAT = "%H:%M:%S"

# Derived from the current repository workflow (AdjusterOrchestrator's
# claim-lifecycle logic and journey-stage tracking), not a placeholder.
# Dispatch belongs to the investigation/loss-assessment phase of a claim
# (claim_journey_master stages "Loss Investigation"/"Loss Assessment"),
# which only ever runs while claims.status is "Open". Approved, Rejected,
# Payment Initiated, and Settled all represent claims that have already
# passed the adjuster's decision point and moved beyond the dispatch stage:
#   - Approved / Rejected — the adjuster's final decision has been made;
#     confirm_payment_approval's own docstring describes this point as
#     having "nothing left to reason about."
#   - Payment Initiated — set in the same call chain that advances the
#     claim's journey stage to "Claim Closed."
#   - Settled — terminal: payment released, policy coverage decremented.
DISPATCH_INELIGIBLE_CLAIM_STATUSES = ("Approved", "Rejected", "Payment Initiated", "Settled")

# Cached lowercase lookup set, built once at import time, so
# validate_claim_dispatch_eligible doesn't re-build a set comprehension on
# every call.
DISPATCH_INELIGIBLE_CLAIM_STATUS_SET = {s.lower() for s in DISPATCH_INELIGIBLE_CLAIM_STATUSES}

# Bounded retry cap for unique-ID generation (see generate_unique_id).
_UNIQUE_ID_MAX_ATTEMPTS = 100

class ValidationError(ValueError):
    """Bad/invalid input -> HTTP 400."""

class NotFoundError(ValueError):
    """Referenced claim/expert/work order does not exist -> HTTP 404."""

def _rand_suffix(n: int) -> str:
    return "".join(random.choices("0123456789", k=n))

def generate_unique_id(cur, prefix: str, column: str, table: str, digits: int = 6) -> str:
    """
    Generates a `{prefix}-{digits}` style ID and re-generates until no row in
    `table` has that value in `column`. Trusts only the database's answer,
    never assumes a randomly generated ID is free. Bounded to
    _UNIQUE_ID_MAX_ATTEMPTS retries so a pathological run of collisions
    can't hang the request indefinitely.
    """
    for _ in range(_UNIQUE_ID_MAX_ATTEMPTS):
        candidate = f"{prefix}-{_rand_suffix(digits)}"
        cur.execute(f"SELECT 1 FROM {table} WHERE {column} = %s", (candidate,))
        if cur.fetchone() is None:
            return candidate
    raise RuntimeError(
        f"Could not generate a unique {prefix}-prefixed ID for {table}.{column} "
        f"after {_UNIQUE_ID_MAX_ATTEMPTS} attempts"
    )

def require_non_empty(value: Optional[str], field: str) -> str:
    if value is None or not str(value).strip():
        raise ValidationError(f"{field} must not be empty")
    return str(value).strip()

def validate_status_value(status: str) -> str:
    if status not in VALID_STATUSES:
        raise ValidationError(f"Invalid status '{status}'. Must be one of {list(VALID_STATUSES)}")
    return status

def validate_priority(priority: str) -> str:
    if priority not in VALID_PRIORITIES:
        raise ValidationError(f"Invalid priority '{priority}'. Must be one of {list(VALID_PRIORITIES)}")
    return priority

def validate_estimated_cost(estimated_cost) -> None:
    if estimated_cost is not None and estimated_cost < 0:
        raise ValidationError("estimated_cost cannot be negative")

def parse_scheduled_date(scheduled_date) -> date:
    """
    Parses scheduled_date into a real `date` object and rejects anything
    earlier than today. Today itself is allowed. Comparison is always
    date-vs-date, never string-vs-string.
    """
    if isinstance(scheduled_date, date) and not isinstance(scheduled_date, datetime):
        parsed = scheduled_date
    else:
        raw = require_non_empty(scheduled_date, "scheduled_date")
        parsed = None
        for fmt in _DATE_FORMATS:
            try:
                parsed = datetime.strptime(raw, fmt).date()
                break
            except ValueError:
                continue
        if parsed is None:
            raise ValidationError(
                f"scheduled_date '{raw}' is not a recognized date (expected YYYY-MM-DD)"
            )
    if parsed < date.today():
        raise ValidationError(f"scheduled_date '{parsed.isoformat()}' cannot be in the past")
    return parsed

def validate_transition(previous_status: str, new_status: str) -> None:
    validate_status_value(new_status)
    if previous_status not in ALLOWED_TRANSITIONS:
        raise ValidationError(f"Work order has unrecognized current status '{previous_status}'")
    if new_status not in ALLOWED_TRANSITIONS[previous_status]:
        raise ValidationError(
            f"Cannot transition work order from '{previous_status}' to '{new_status}'"
        )

def get_claim_by_number(cur, claim_number: str) -> dict:
    """Looks up the claims row that is the source of truth for this claim_number."""
    claim_number = require_non_empty(claim_number, "claim_number")
    cur.execute("SELECT * FROM claims WHERE claim_number = %s", (claim_number,))
    row = row_to_dict(cur.fetchone())
    if not row:
        raise NotFoundError(f"Claim with claim_number '{claim_number}' not found")
    return row

def get_expert_by_id(cur, expert_id: str) -> dict:
    """Looks up the experts row that is the source of truth for this expert_id."""
    expert_id = require_non_empty(expert_id, "expert_id")
    cur.execute("SELECT * FROM experts WHERE expert_id = %s", (expert_id,))
    row = row_to_dict(cur.fetchone())
    if not row:
        raise NotFoundError(f"Expert with expert_id '{expert_id}' not found")
    return row

def validate_scheduled_time(scheduled_time: str) -> str:
    """
    Parses scheduled_time with datetime.strptime (not regex) so malformed
    values ('abcd', '99:88', '25:00') are rejected by real time parsing.
    Accepts 24-hour ('14:30', '14:30:00') or 12-hour with AM/PM
    ('10:30 AM', '02:45 PM'). Always returns the normalized 'HH:MM:SS'
    (24-hour) form, so storage and the double-booking comparison both work
    off one consistent representation regardless of how it was entered.
    """
    raw = require_non_empty(scheduled_time, "scheduled_time")
    for fmt in _TIME_FORMATS:
        try:
            parsed = datetime.strptime(raw, fmt)
            return parsed.strftime(_TIME_STORAGE_FORMAT)
        except ValueError:
            continue
    raise ValidationError(
        f"scheduled_time '{raw}' is not a valid time (expected e.g. '14:30' or '2:30 PM')"
    )

def validate_claim_dispatch_eligible(claim: dict) -> None:
    """
    Rejects dispatch for claims that have already passed the
    investigation/loss-assessment phase. See the DISPATCH_INELIGIBLE_CLAIM_STATUSES
    comment above for the repository evidence behind this list.
    """
    status = (claim.get("status") or "").strip()
    if status and status.lower() in DISPATCH_INELIGIBLE_CLAIM_STATUS_SET:
        raise ValidationError(
            f"Claim '{claim.get('claim_number')}' is not eligible for dispatch (status: '{status}')"
        )

def validate_expert_active(expert: dict) -> None:
    """
    Rejects dispatch to an expert who is disabled. experts.active is a real
    BOOLEAN column (confirmed against the live database) — experts are
    enabled/disabled via this flag, not a status enum. active == True
    allows dispatch; active == False is rejected. No string comparison is
    involved.
    """
    if expert.get("active") is False:
        raise ValidationError(
            f"Expert '{expert.get('expert_id')}' is inactive and cannot be assigned"
        )

def has_active_work_order(cur, claim_number: str) -> bool:
    """True if this claim already has a Scheduled/In Progress work order."""
    cur.execute(
        "SELECT 1 FROM work_orders WHERE claim_number = %s AND status = ANY(%s) LIMIT 1",
        (claim_number, list(ACTIVE_STATUSES)),
    )
    return cur.fetchone() is not None

def is_expert_double_booked(cur, expert_id: str, scheduled_date: date, scheduled_time: str) -> bool:
    """True if this expert already has an active work order at this date/time."""
    cur.execute(
        """
        SELECT 1 FROM work_orders
        WHERE expert_id = %s AND scheduled_date = %s AND scheduled_time = %s
          AND status = ANY(%s)
        LIMIT 1
        """,
        (expert_id, scheduled_date, scheduled_time, list(ACTIVE_STATUSES)),
    )
    return cur.fetchone() is not None

"""
handler.py — Dispatch
────────────────────────
Creates and tracks work orders for vendor/expert dispatch, with a
dispatch_logs audit trail.

PostgreSQL is always the source of truth. The LLM/caller only expresses
intent (which claim, which expert, when); claim_id, expert_name,
expert_type, and customer_address are never taken from the request — they
are always fetched fresh from claims/experts and written as-is, overwriting
whatever (if anything) the request supplied. See validation.py for the
shared checks and the exact column list each query relies on.

Known, confirmed schema gaps (do not touch, per the actual DB):
  - claims has no customer_phone / customer_email columns, so those two
    work_orders fields are left exactly as supplied by the caller.
"""

import logging
import os
import sys
from datetime import datetime
from typing import Optional

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "common"))

from db import get_db_connection, row_to_dict  # noqa: E402

from dispatch_mcp import validation as v  # noqa: E402

log = logging.getLogger(__name__)

def create_work_order(claim_id: str, claim_number: str, expert_id: str, expert_name: str,
                       expert_type: str, scheduled_date: str, scheduled_time: str,
                       customer_address: str, assigned_by: str,
                       estimated_arrival: Optional[str] = None,
                       estimated_cost: Optional[float] = None,
                       priority: str = "Normal",
                       notes_to_expert: Optional[str] = None,
                       customer_phone: Optional[str] = None,
                       customer_email: Optional[str] = None) -> dict:
    """
    Creates a work_orders row and a matching 'Created' dispatch_logs row.

    claim_id, expert_name, expert_type, and customer_address are function
    parameters only for public-API compatibility with the existing MCP
    tool/model signature — their values are IGNORED. The real values always
    come from claims.id, experts.name, experts.expert_type, and
    claims.location respectively.

    customer_phone/customer_email are passed through unchanged: claims has
    no columns for either, so there is no database source of truth to
    validate or overwrite them against.
    """
    v.require_non_empty(assigned_by, "assigned_by")
    priority = v.validate_priority(priority or "Normal")
    v.validate_estimated_cost(estimated_cost)
    parsed_scheduled_date = v.parse_scheduled_date(scheduled_date)
    scheduled_time = v.validate_scheduled_time(scheduled_time)

    conn = get_db_connection()
    try:
        cur = conn.cursor()

        # 1 & 2 — claim must exist (looked up by claim_number).
        claim = v.get_claim_by_number(cur, claim_number)

        # claim must be in a dispatch-eligible status (not Closed/Rejected/etc).
        v.validate_claim_dispatch_eligible(claim)

        # 3 — claims.id is the only source of truth for work_orders.claim_id.
        true_claim_id = claim["id"]

        # 4 — customer_address always comes from claims.location.
        true_customer_address = claim.get("location")

        # 6 & 7 — expert must exist; expert_name/expert_type always come from experts.
        expert = v.get_expert_by_id(cur, expert_id)

        # expert must be active (experts.active BOOLEAN column).
        v.validate_expert_active(expert)

        true_expert_id = expert["expert_id"]
        true_expert_name = expert["name"]
        true_expert_type = expert["expert_type"]

        # 8 — only one active (Scheduled/In Progress) work order per claim.
        if v.has_active_work_order(cur, claim["claim_number"]):
            raise v.ValidationError(
                f"Claim '{claim['claim_number']}' already has an active work order"
            )

        # 17 — the expert can't already be booked at this date/time.
        if v.is_expert_double_booked(cur, true_expert_id, parsed_scheduled_date, scheduled_time):
            raise v.ValidationError(
                f"Expert '{true_expert_id}' is already booked on "
                f"{parsed_scheduled_date.isoformat()} at {scheduled_time}"
            )

        # 15 — generate a unique work_order_id.
        work_order_id = v.generate_unique_id(cur, "WO", "work_order_id", "work_orders")

        cur.execute(
            """
            INSERT INTO work_orders (work_order_id, claim_id, claim_number, expert_id, expert_name,
                                      expert_type, scheduled_date, scheduled_time, estimated_arrival,
                                      estimated_cost, status, priority, notes_to_expert,
                                      customer_address, customer_phone, customer_email, assigned_by)
            VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s, 'Scheduled', %s, %s, %s, %s, %s, %s)
            """,
            (work_order_id, true_claim_id, claim["claim_number"], true_expert_id, true_expert_name,
             true_expert_type, parsed_scheduled_date, scheduled_time, estimated_arrival, estimated_cost,
             priority, notes_to_expert, true_customer_address, customer_phone, customer_email, assigned_by),
        )

        # 15 — generate a unique log_id.
        log_id = v.generate_unique_id(cur, "LOG", "log_id", "dispatch_logs")
        cur.execute(
            """
            INSERT INTO dispatch_logs (log_id, work_order_id, claim_id, action, action_by, details,
                                        previous_status, new_status)
            VALUES (%s,%s,%s, 'Created', %s, %s, NULL, 'Scheduled')
            """,
            (log_id, work_order_id, true_claim_id, assigned_by,
             f"Work order created for {true_expert_name} ({true_expert_type}) on "
             f"{parsed_scheduled_date.isoformat()} {scheduled_time}"),
        )
        conn.commit()

        cur.execute("SELECT * FROM work_orders WHERE work_order_id = %s", (work_order_id,))
        return row_to_dict(cur.fetchone())
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()

def get_work_order(work_order_id: str) -> Optional[dict]:
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute("SELECT * FROM work_orders WHERE work_order_id = %s", (work_order_id,))
        return row_to_dict(cur.fetchone())
    finally:
        conn.close()

def list_work_orders(claim_id: Optional[str] = None, status: Optional[str] = None) -> list:
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        query = "SELECT * FROM work_orders WHERE 1=1"
        params = []
        if claim_id:
            query += " AND claim_id = %s"
            params.append(claim_id)
        if status:
            query += " AND status = %s"
            params.append(status)
        query += " ORDER BY id DESC"
        cur.execute(query, params)
        return row_to_dict(cur.fetchall())
    finally:
        conn.close()

def update_work_order_status(work_order_id: str, status: str, action_by: str,
                              details: Optional[str] = None) -> dict:
    v.require_non_empty(action_by, "action_by")

    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute("SELECT * FROM work_orders WHERE work_order_id = %s", (work_order_id,))
        wo = row_to_dict(cur.fetchone())
        if not wo:
            raise v.NotFoundError(f"Work order '{work_order_id}' not found")

        previous_status = wo["status"]
        # 9 & 10 — only known statuses, only allowed transitions.
        v.validate_transition(previous_status, status)

        now = datetime.now().isoformat()

        updates = ["status = %s"]
        params = [status]
        if status == "In Progress":
            updates.append("started_at = %s")
            params.append(now)
        elif status == "Completed":
            updates.append("completed_at = %s")
            params.append(now)
        elif status == "Canceled":
            updates.append("canceled_at = %s")
            params.append(now)
            if details:
                updates.append("cancel_reason = %s")
                params.append(details)

        params.append(work_order_id)
        cur.execute(f"UPDATE work_orders SET {', '.join(updates)} WHERE work_order_id = %s", params)

        # 16 — log references the real work order/claim and the real previous status.
        log_id = v.generate_unique_id(cur, "LOG", "log_id", "dispatch_logs")
        cur.execute(
            """
            INSERT INTO dispatch_logs (log_id, work_order_id, claim_id, action, action_by, details,
                                        previous_status, new_status)
            VALUES (%s,%s,%s, 'Status Update', %s,%s,%s,%s)
            """,
            (log_id, work_order_id, wo["claim_id"], action_by, details, previous_status, status),
        )
        conn.commit()

        cur.execute("SELECT * FROM work_orders WHERE work_order_id = %s", (work_order_id,))
        return row_to_dict(cur.fetchone())
    except Exception:
        conn.rollback()
        raise
    finally:
        conn.close()

def get_dispatch_logs(work_order_id: str) -> list:
    conn = get_db_connection()
    try:
        cur = conn.cursor()
        cur.execute("SELECT * FROM dispatch_logs WHERE work_order_id = %s ORDER BY id ASC", (work_order_id,))
        return row_to_dict(cur.fetchall())
    finally:
        conn.close()

"""
dispatch_router.py
─────────────────────
FastAPI routes for the Dispatch MCP.

Tool / Endpoint map:
  create_work_order         POST /api/dispatch/work_orders
  get_work_order            GET  /api/dispatch/work_orders/{work_order_id}
  list_work_orders          GET  /api/dispatch/work_orders
  update_work_order_status  POST /api/dispatch/work_orders/{work_order_id}/status
  get_dispatch_logs         GET  /api/dispatch/work_orders/{work_order_id}/logs
"""

import logging
from typing import Optional

from fastapi import APIRouter, HTTPException

from dispatch_mcp import handler
from dispatch_mcp.models import CreateWorkOrderRequest, UpdateWorkOrderStatusRequest
from dispatch_mcp.validation import NotFoundError, ValidationError

log = logging.getLogger(__name__)

router = APIRouter()

@router.post(
    "/api/dispatch/work_orders",
    operation_id="create_work_order",
    summary="Create a new work order and dispatch log entry",
    tags=["Dispatch"],
)
def create_work_order(body: CreateWorkOrderRequest):
    """Inserts a new work_orders row (status 'Scheduled') and a 'Created' dispatch_logs row."""
    try:
        return handler.create_work_order(
            body.claim_id, body.claim_number, body.expert_id, body.expert_name, body.expert_type,
            body.scheduled_date, body.scheduled_time, body.customer_address, body.assigned_by,
            body.estimated_arrival, body.estimated_cost, body.priority, body.notes_to_expert,
            body.customer_phone, body.customer_email,
        )
    except NotFoundError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValidationError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        log.exception("create_work_order error")
        raise HTTPException(status_code=500, detail=str(e))

@router.get(
    "/api/dispatch/work_orders/{work_order_id}",
    operation_id="get_work_order",
    summary="Get a work order by work_order_id",
    tags=["Dispatch"],
)
def get_work_order(work_order_id: str):
    """Returns the work_orders row for the given work_order_id, or null."""
    return handler.get_work_order(work_order_id)

@router.get(
    "/api/dispatch/work_orders",
    operation_id="list_work_orders",
    summary="List work orders, optionally filtered by claim_id and/or status",
    tags=["Dispatch"],
)
def list_work_orders(claim_id: Optional[str] = None, status: Optional[str] = None):
    """Returns work_orders rows, optionally filtered."""
    return handler.list_work_orders(claim_id, status)

@router.post(
    "/api/dispatch/work_orders/{work_order_id}/status",
    operation_id="update_work_order_status",
    summary="Update a work order's status and log the transition",
    tags=["Dispatch"],
)
def update_work_order_status(work_order_id: str, body: UpdateWorkOrderStatusRequest):
    """
    Updates work_orders.status (setting started_at/completed_at/canceled_at
    as appropriate) and inserts a dispatch_logs row recording the previous
    and new status.
    """
    try:
        return handler.update_work_order_status(work_order_id, body.status, body.action_by, body.details)
    except NotFoundError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except ValidationError as e:
        raise HTTPException(status_code=400, detail=str(e))
    except Exception as e:
        log.exception("update_work_order_status error")
        raise HTTPException(status_code=500, detail=str(e))

@router.get(
    "/api/dispatch/work_orders/{work_order_id}/logs",
    operation_id="get_dispatch_logs",
    summary="Get the dispatch audit trail for a work order",
    tags=["Dispatch"],
)
def get_dispatch_logs(work_order_id: str):
    """Returns dispatch_logs rows for the given work_order_id, ordered chronologically."""
    return handler.get_dispatch_logs(work_order_id)
