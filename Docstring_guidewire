"""
handler.py — Dispatch
────────────────────────
Creates and tracks work orders for vendor/expert dispatch, with a
dispatch_logs audit trail.
PostgreSQL is always the source of truth. The LLM/caller only expresses
intent (which claim, which expert, when); claim_id, expert_name,
expert_type, and customer_address are not accepted as request input at
all — they are always looked up fresh from claims/experts using
claim_number/expert_id. See validation.py for the shared checks and the
exact column list each query relies on.
Known, confirmed schema gaps (do not touch, per the actual DB):
 - claims has no customer_phone / customer_email columns, so those two
   work_orders fields are left exactly as supplied by the caller.
"""
import logging
import os
import sys
from datetime import datetime
from typing import Optional
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "common"))
from db import get_db_connection, row_to_dict  # noqa: E402
from dispatch_mcp import validation as v  # noqa: E402
log = logging.getLogger(__name__)

def create_work_order(claim_number: str, expert_id: str, scheduled_date: str, scheduled_time: str,
                      assigned_by: str,
                      estimated_arrival: Optional[str] = None,
                      estimated_cost: Optional[float] = None,
                      priority: str = "Normal",
                      notes_to_expert: Optional[str] = None,
                      customer_phone: Optional[str] = None,
                      customer_email: Optional[str] = None) -> dict:
   """
   Creates a work_orders row and a matching 'Created' dispatch_logs row.
   claim_id, expert_name, expert_type, and customer_address are not caller
   inputs — they always come from claims.id, experts.name,
   experts.expert_type, and claims.location respectively, looked up here
   from claim_number/expert_id.
   customer_phone/customer_email are passed through unchanged: claims has
   no columns for either, so there is no database source of truth to
   validate or overwrite them against.
   """
   v.require_non_empty(assigned_by, "assigned_by")
   priority = v.validate_priority(priority or "Normal")
   v.validate_estimated_cost(estimated_cost)
   parsed_scheduled_date = v.parse_scheduled_date(scheduled_date)
   scheduled_time = v.validate_scheduled_time(scheduled_time)
   conn = get_db_connection()
   try:
       cur = conn.cursor()
       # 1 & 2 — claim must exist (looked up by claim_number).
       claim = v.get_claim_by_number(cur, claim_number)
       # claim must be in a dispatch-eligible status (not Closed/Rejected/etc).
       v.validate_claim_dispatch_eligible(claim)
       # 3 — claims.id is the only source of truth for work_orders.claim_id.
       true_claim_id = claim["id"]
       # 4 — customer_address always comes from claims.location.
       true_customer_address = claim.get("location")
       # 6 & 7 — expert must exist; expert_name/expert_type always come from experts.
       expert = v.get_expert_by_id(cur, expert_id)
       # expert must be active (experts.active BOOLEAN column).
       v.validate_expert_active(expert)
       true_expert_id = expert["expert_id"]
       true_expert_name = expert["name"]
       true_expert_type = expert["expert_type"]
       # 8 — only one active (Scheduled/In Progress) work order per claim.
       if v.has_active_work_order(cur, claim["claim_number"]):
           raise v.ValidationError(
               f"Claim '{claim['claim_number']}' already has an active work order"
           )
       # 17 — the expert can't already be booked at this date/time.
       if v.is_expert_double_booked(cur, true_expert_id, parsed_scheduled_date, scheduled_time):
           raise v.ValidationError(
               f"Expert '{true_expert_id}' is already booked on "
               f"{parsed_scheduled_date.isoformat()} at {scheduled_time}"
           )
       # 15 — generate a unique work_order_id.
       work_order_id = v.generate_unique_id(cur, "WO", "work_order_id", "work_orders")
       cur.execute(
           """
           INSERT INTO work_orders (work_order_id, claim_id, claim_number, expert_id, expert_name,
                                     expert_type, scheduled_date, scheduled_time, estimated_arrival,
                                     estimated_cost, status, priority, notes_to_expert,
                                     customer_address, customer_phone, customer_email, assigned_by)
           VALUES (%s,%s,%s,%s,%s,%s,%s,%s,%s,%s, 'Scheduled', %s, %s, %s, %s, %s, %s)
           """,
           (work_order_id, true_claim_id, claim["claim_number"], true_expert_id, true_expert_name,
            true_expert_type, parsed_scheduled_date, scheduled_time, estimated_arrival, estimated_cost,
            priority, notes_to_expert, true_customer_address, customer_phone, customer_email, assigned_by),
       )
       # 15 — generate a unique log_id.
       log_id = v.generate_unique_id(cur, "LOG", "log_id", "dispatch_logs")
       cur.execute(
           """
           INSERT INTO dispatch_logs (log_id, work_order_id, claim_id, action, action_by, details,
                                       previous_status, new_status)
           VALUES (%s,%s,%s, 'Created', %s, %s, NULL, 'Scheduled')
           """,
           (log_id, work_order_id, true_claim_id, assigned_by,
            f"Work order created for {true_expert_name} ({true_expert_type}) on "
            f"{parsed_scheduled_date.isoformat()} {scheduled_time}"),
       )
       conn.commit()
       cur.execute("SELECT * FROM work_orders WHERE work_order_id = %s", (work_order_id,))
       return row_to_dict(cur.fetchone())
   except Exception:
       conn.rollback()
       raise
   finally:
       conn.close()

def get_work_order(work_order_id: str) -> Optional[dict]:
   conn = get_db_connection()
   try:
       cur = conn.cursor()
       cur.execute("SELECT * FROM work_orders WHERE work_order_id = %s", (work_order_id,))
       return row_to_dict(cur.fetchone())
   finally:
       conn.close()

def list_work_orders(claim_id: Optional[str] = None, status: Optional[str] = None) -> list:
   conn = get_db_connection()
   try:
       cur = conn.cursor()
       query = "SELECT * FROM work_orders WHERE 1=1"
       params = []
       if claim_id:
           query += " AND claim_id = %s"
           params.append(claim_id)
       if status:
           query += " AND status = %s"
           params.append(status)
       query += " ORDER BY id DESC"
       cur.execute(query, params)
       return row_to_dict(cur.fetchall())
   finally:
       conn.close()

def update_work_order_status(work_order_id: str, status: str, action_by: str,
                             details: Optional[str] = None) -> dict:
   v.require_non_empty(action_by, "action_by")
   conn = get_db_connection()
   try:
       cur = conn.cursor()
       cur.execute("SELECT * FROM work_orders WHERE work_order_id = %s", (work_order_id,))
       wo = row_to_dict(cur.fetchone())
       if not wo:
           raise v.NotFoundError(f"Work order '{work_order_id}' not found")
       previous_status = wo["status"]
       # 9 & 10 — only known statuses, only allowed transitions.
       v.validate_transition(previous_status, status)
       now = datetime.now().isoformat()
       updates = ["status = %s"]
       params = [status]
       if status == "In Progress":
           updates.append("started_at = %s")
           params.append(now)
       elif status == "Completed":
           updates.append("completed_at = %s")
           params.append(now)
       elif status == "Canceled":
           updates.append("canceled_at = %s")
           params.append(now)
           if details:
               updates.append("cancel_reason = %s")
               params.append(details)
       params.append(work_order_id)
       cur.execute(f"UPDATE work_orders SET {', '.join(updates)} WHERE work_order_id = %s", params)
       # 16 — log references the real work order/claim and the real previous status.
       log_id = v.generate_unique_id(cur, "LOG", "log_id", "dispatch_logs")
       cur.execute(
           """
           INSERT INTO dispatch_logs (log_id, work_order_id, claim_id, action, action_by, details,
                                       previous_status, new_status)
           VALUES (%s,%s,%s, 'Status Update', %s,%s,%s,%s)
           """,
           (log_id, work_order_id, wo["claim_id"], action_by, details, previous_status, status),
       )
       conn.commit()
       cur.execute("SELECT * FROM work_orders WHERE work_order_id = %s", (work_order_id,))
       return row_to_dict(cur.fetchone())
   except Exception:
       conn.rollback()
       raise
   finally:
       conn.close()

def get_dispatch_logs(work_order_id: str) -> list:
   conn = get_db_connection()
   try:
       cur = conn.cursor()
       cur.execute("SELECT * FROM dispatch_logs WHERE work_order_id = %s ORDER BY id ASC", (work_order_id,))
       return row_to_dict(cur.fetchall())
   finally:
       conn.close()



