"""
agent_v1_naive.py
─────────────────
Claim intake triage agent, version 1.

    free-text note  ->  extract node (LLM)  ->  router  ->  decision node

The parsing in extract_node is deliberately the SAME pattern used in the
reserve_recommendation handler:

    content = response.content.strip().strip("`")
    if content.startswith("json"):
        content = content[4:]
    try:
        data = json.loads(content)
    except Exception:
        data = {}

The point of this file is not that the parsing is ugly. It is that the
ROUTER has to make a real decision from whatever comes back, and when the
parse degrades, the routing degrades with it - silently.

Run:
    python agent_v1_naive.py
"""

import json
import os
from typing import Optional, TypedDict

from dotenv import find_dotenv, load_dotenv
from langchain_openai import AzureChatOpenAI
from langgraph.graph import END, START, StateGraph

from claims import CLAIMS

load_dotenv(find_dotenv())


# ══════════════════════════════════════════════════════════════════════
# STATE
# ══════════════════════════════════════════════════════════════════════

class State(TypedDict):
    claim_id: str
    note: str
    extracted: dict
    parse_failed: bool
    route_reason: str
    decision: str


# ══════════════════════════════════════════════════════════════════════
# MODEL
# ══════════════════════════════════════════════════════════════════════

def get_llm():
    return AzureChatOpenAI(
        api_key=os.getenv("AZURE_OPENAI_API_KEY"),
        api_version=os.getenv("AZURE_OPENAI_API_VERSION"),
        azure_deployment=os.getenv("AZURE_OPENAI_CHAT_DEPLOYMENT"),
        azure_endpoint=os.getenv("AZURE_OPENAI_ENDPOINT"),
        temperature=0,
    )


EXTRACT_PROMPT = """You are a claims intake assistant.

Read the adjuster's note below and extract the key fields.

NOTE:
{note}

Respond ONLY as JSON, with exactly these keys:

{{
  "loss_type": "...",
  "incident_date": "YYYY-MM-DD",
  "estimated_amount": 0.0,
  "severity": "Low" or "Medium" or "High" or "Critical",
  "injuries_reported": true or false
}}

Respond ONLY as JSON. Do not include any other text.
"""


# ══════════════════════════════════════════════════════════════════════
# NODE 1 - EXTRACT
# ══════════════════════════════════════════════════════════════════════

def extract_node(state: State) -> dict:
    llm = get_llm()

    response = llm.invoke(EXTRACT_PROMPT.format(note=state["note"]))

    # ---- the hand-rolled parsing, exactly as in the reserve handler ----
    content = response.content.strip().strip("`")
    if content.startswith("json"):
        content = content[4:]

    try:
        data = json.loads(content)
        parse_failed = False
    except Exception:
        data = {}
        parse_failed = True
    # -------------------------------------------------------------------

    return {
        "extracted": data,
        "parse_failed": parse_failed,
        # keep the raw text so the comparison script can show what came back
        "_raw": response.content,
    }


# ══════════════════════════════════════════════════════════════════════
# ROUTER - this is where the damage shows up
# ══════════════════════════════════════════════════════════════════════

HIGH_VALUE_THRESHOLD = 10_000

SEVERITY_RANK = {"Low": 1, "Medium": 2, "High": 3, "Critical": 4}


def triage_router(state: State) -> str:
    """
    Business rule:
        - anything over 10,000            -> manual review
        - severity High or Critical       -> manual review
        - injuries reported               -> manual review
        - otherwise                       -> fast track

    The router has to work with whatever extract_node produced. Watch what
    it has to do to survive that.
    """
    data = state.get("extracted") or {}

    if state.get("parse_failed"):
        return "needs_human"

    amount = data.get("estimated_amount")
    severity = data.get("severity")
    injuries = data.get("injuries_reported")

    # PROBLEM 1: amount might be a string like "$15,500.00" or "twelve thousand",
    # or missing entirely. A bare comparison raises TypeError.
    try:
        if amount is not None and float(amount) > HIGH_VALUE_THRESHOLD:
            return "manual_review"
    except (TypeError, ValueError):
        # We cannot compare it. So we... guess. This is the quiet failure.
        return "needs_human"

    # PROBLEM 2: severity might be "Moderate", "medium", "MEDIUM", or a
    # sentence. A dict lookup on an unexpected label returns None.
    if SEVERITY_RANK.get(severity, 0) >= 3:
        return "manual_review"

    # PROBLEM 3: injuries might be the STRING "false", which is truthy.
    if injuries:
        return "manual_review"

    return "fast_track"


# ══════════════════════════════════════════════════════════════════════
# DECISION NODES
# ══════════════════════════════════════════════════════════════════════

def fast_track_node(state: State) -> dict:
    return {"decision": "FAST_TRACK", "route_reason": "under threshold, low severity"}


def manual_review_node(state: State) -> dict:
    return {"decision": "MANUAL_REVIEW", "route_reason": "high value / severity / injuries"}


def needs_human_node(state: State) -> dict:
    return {"decision": "NEEDS_HUMAN", "route_reason": "could not read the extraction"}


# ══════════════════════════════════════════════════════════════════════
# GRAPH
# ══════════════════════════════════════════════════════════════════════

def build_graph():
    builder = StateGraph(State)

    builder.add_node("extract", extract_node)
    builder.add_node("fast_track", fast_track_node)
    builder.add_node("manual_review", manual_review_node)
    builder.add_node("needs_human", needs_human_node)

    builder.add_edge(START, "extract")

    builder.add_conditional_edges(
        "extract",
        triage_router,
        {
            "fast_track": "fast_track",
            "manual_review": "manual_review",
            "needs_human": "needs_human",
        },
    )

    builder.add_edge("fast_track", END)
    builder.add_edge("manual_review", END)
    builder.add_edge("needs_human", END)

    return builder.compile()


# ══════════════════════════════════════════════════════════════════════
# RUN
# ══════════════════════════════════════════════════════════════════════

def run_one(graph, claim):
    return graph.invoke({"claim_id": claim["id"], "note": claim["note"]})


if __name__ == "__main__":
    graph = build_graph()

    print("\n" + "=" * 78)
    print("AGENT v1 - NAIVE JSON PARSING")
    print("=" * 78)

    for claim in CLAIMS:
        result = run_one(graph, claim)
        data = result.get("extracted") or {}

        print(f"\n{claim['id']}  ->  {result.get('decision')}")
        print(f"  parse_failed     : {result.get('parse_failed')}")
        print(f"  estimated_amount : {data.get('estimated_amount')!r}"
              f"   (type: {type(data.get('estimated_amount')).__name__})")
        print(f"  severity         : {data.get('severity')!r}")
        print(f"  incident_date    : {data.get('incident_date')!r}")
        print(f"  injuries         : {data.get('injuries_reported')!r}"
              f"   (type: {type(data.get('injuries_reported')).__name__})")
        print(f"  raw response     : {str(result.get('_raw'))[:70]!r}...")


"""
agent_v2_structured.py
──────────────────────
The SAME agent, with one thing changed: the extract node uses a Pydantic
schema instead of hand-parsed JSON.

    free-text note  ->  extract node (LLM)  ->  router  ->  decision node

Compare this file against agent_v1_naive.py side by side. The graph is
identical. The prompt is shorter. The router is smaller. That shrinkage
is the actual result.

Run:
    python agent_v2_structured.py
"""

import os
from typing import Literal, Optional, TypedDict

from dotenv import find_dotenv, load_dotenv
from langchain_openai import AzureChatOpenAI
from langgraph.graph import END, START, StateGraph
from pydantic import BaseModel, Field

from claims import CLAIMS

load_dotenv(find_dotenv())


# ══════════════════════════════════════════════════════════════════════
# THE SCHEMA - this replaces the prompt's format instructions
# ══════════════════════════════════════════════════════════════════════

class ClaimIntake(BaseModel):
    """Structured fields extracted from an adjuster's free-text intake note."""

    loss_type: str = Field(
        description="Short category of loss, e.g. water, fire, theft, collision, storm."
    )

    incident_date: Optional[str] = Field(
        default=None,
        description=(
            "Date of the incident in YYYY-MM-DD format. "
            "Null if the note does not state a specific date - do NOT guess "
            "from relative references like 'last Tuesday'."
        ),
    )

    estimated_amount: Optional[float] = Field(
        default=None,
        description=(
            "Best single estimate of the claim cost as a plain number, no currency "
            "symbol or thousands separators. If several estimates are given, use the "
            "one the adjuster is proceeding with. Null if no figure is stated."
        ),
    )

    amount_is_approximate: bool = Field(
        description=(
            "True if the amount was stated vaguely (for example 'around twelve "
            "thousand' or a range). False if a precise figure was given."
        )
    )

    severity: Literal["Low", "Medium", "High", "Critical"] = Field(
        description=(
            "Severity of the loss. Must be exactly one of: Low, Medium, High, Critical."
        )
    )

    injuries_reported: bool = Field(
        description="True only if the note states that someone was injured."
    )


# ══════════════════════════════════════════════════════════════════════
# STATE
# ══════════════════════════════════════════════════════════════════════

class State(TypedDict):
    claim_id: str
    note: str
    extracted: Optional[ClaimIntake]
    parse_failed: bool
    route_reason: str
    decision: str


def get_llm():
    return AzureChatOpenAI(
        api_key=os.getenv("AZURE_OPENAI_API_KEY"),
        api_version=os.getenv("AZURE_OPENAI_API_VERSION"),
        azure_deployment=os.getenv("AZURE_OPENAI_CHAT_DEPLOYMENT"),
        azure_endpoint=os.getenv("AZURE_OPENAI_ENDPOINT"),
        temperature=0,
    )


# Note what is NOT here any more: no key list, no example object,
# no "Respond ONLY as JSON" (which appeared twice in v1).
EXTRACT_PROMPT = """You are a claims intake assistant.

Read the adjuster's note below and extract the key fields.

NOTE:
{note}
"""


# ══════════════════════════════════════════════════════════════════════
# NODE 1 - EXTRACT
# ══════════════════════════════════════════════════════════════════════

def extract_node(state: State) -> dict:
    llm = get_llm()

    # include_raw=True so a failure returns a result instead of raising
    structured_llm = llm.with_structured_output(ClaimIntake, include_raw=True)

    result = structured_llm.invoke(EXTRACT_PROMPT.format(note=state["note"]))

    parsed = result.get("parsed")
    error = result.get("parsing_error")

    if error is not None or parsed is None:
        print(f"  [!] STRUCTURED_EXTRACT_FAILED {state['claim_id']}: {error}")
        return {"extracted": None, "parse_failed": True, "_raw": result.get("raw")}

    return {"extracted": parsed, "parse_failed": False, "_raw": result.get("raw")}


# ══════════════════════════════════════════════════════════════════════
# ROUTER - compare this with v1
# ══════════════════════════════════════════════════════════════════════

HIGH_VALUE_THRESHOLD = 10_000

SEVERITY_RANK = {"Low": 1, "Medium": 2, "High": 3, "Critical": 4}


def triage_router(state: State) -> str:
    """
    Same business rule as v1. No try/except, no type coercion, no guessing.

    estimated_amount is a float or None - guaranteed.
    severity is one of four strings - guaranteed.
    injuries_reported is a bool - guaranteed.
    """
    if state.get("parse_failed"):
        return "needs_human"

    data: ClaimIntake = state["extracted"]

    if data.estimated_amount is not None and data.estimated_amount > HIGH_VALUE_THRESHOLD:
        return "manual_review"

    if SEVERITY_RANK[data.severity] >= 3:
        return "manual_review"

    if data.injuries_reported:
        return "manual_review"

    # A genuine business decision that v1 could not even express:
    # no figure yet, so there is nothing to fast-track on.
    if data.estimated_amount is None:
        return "needs_human"

    return "fast_track"


def fast_track_node(state: State) -> dict:
    return {"decision": "FAST_TRACK", "route_reason": "under threshold, low severity"}


def manual_review_node(state: State) -> dict:
    return {"decision": "MANUAL_REVIEW", "route_reason": "high value / severity / injuries"}


def needs_human_node(state: State) -> dict:
    return {"decision": "NEEDS_HUMAN", "route_reason": "missing amount or failed extraction"}


def build_graph():
    builder = StateGraph(State)

    builder.add_node("extract", extract_node)
    builder.add_node("fast_track", fast_track_node)
    builder.add_node("manual_review", manual_review_node)
    builder.add_node("needs_human", needs_human_node)

    builder.add_edge(START, "extract")

    builder.add_conditional_edges(
        "extract",
        triage_router,
        {
            "fast_track": "fast_track",
            "manual_review": "manual_review",
            "needs_human": "needs_human",
        },
    )

    builder.add_edge("fast_track", END)
    builder.add_edge("manual_review", END)
    builder.add_edge("needs_human", END)

    return builder.compile()


def run_one(graph, claim):
    return graph.invoke({"claim_id": claim["id"], "note": claim["note"]})


if __name__ == "__main__":
    graph = build_graph()

    print("\n" + "=" * 78)
    print("AGENT v2 - STRUCTURED OUTPUT")
    print("=" * 78)

    for claim in CLAIMS:
        result = run_one(graph, claim)
        data: Optional[ClaimIntake] = result.get("extracted")

        print(f"\n{claim['id']}  ->  {result.get('decision')}")
        print(f"  parse_failed     : {result.get('parse_failed')}")

        if data:
            print(f"  estimated_amount : {data.estimated_amount!r}"
                  f"   (type: {type(data.estimated_amount).__name__})")
            print(f"  approximate?     : {data.amount_is_approximate}")
            print(f"  severity         : {data.severity!r}")
            print(f"  incident_date    : {data.incident_date!r}")
            print(f"  injuries         : {data.injuries_reported!r}"
                  f"   (type: {type(data.injuries_reported).__name__})")


"""
compare.py
──────────
Runs both agents over the same ten claims and puts the results side by side.

This is the file that makes the point. Look for three things:

  1  Rows where the two agents DISAGREE on the routing decision.
     That is a claim being sent to the wrong queue.

  2  The 'type' column for v1. Anything that is not 'float' means the
     router had to coerce or guess.

  3  The severity column for v1. Anything outside Low/Medium/High/Critical
     means the SEVERITY_RANK lookup silently returned 0.

Run:
    python compare.py
"""

import agent_v1_naive as v1
import agent_v2_structured as v2
from claims import CLAIMS


def truncate(value, width):
    text = str(value)
    return text if len(text) <= width else text[: width - 1] + "\u2026"


def main():
    graph_v1 = v1.build_graph()
    graph_v2 = v2.build_graph()

    rows = []
    disagreements = 0
    v1_type_problems = 0
    v1_severity_problems = 0

    valid_severities = {"Low", "Medium", "High", "Critical"}

    for claim in CLAIMS:
        print(f"running {claim['id']} ...")

        r1 = graph_v1.invoke({"claim_id": claim["id"], "note": claim["note"]})
        r2 = graph_v2.invoke({"claim_id": claim["id"], "note": claim["note"]})

        d1 = r1.get("extracted") or {}
        d2 = r2.get("extracted")

        amt1 = d1.get("estimated_amount")
        sev1 = d1.get("severity")

        amt1_type = type(amt1).__name__
        if amt1 is not None and not isinstance(amt1, (int, float)):
            v1_type_problems += 1
        if sev1 is not None and sev1 not in valid_severities:
            v1_severity_problems += 1

        decision1 = r1.get("decision")
        decision2 = r2.get("decision")
        if decision1 != decision2:
            disagreements += 1

        rows.append({
            "id": claim["id"],
            "v1_amt": amt1,
            "v1_type": amt1_type,
            "v1_sev": sev1,
            "v1_decision": decision1,
            "v2_amt": d2.estimated_amount if d2 else None,
            "v2_sev": d2.severity if d2 else None,
            "v2_decision": decision2,
            "differs": decision1 != decision2,
        })

    # ── table ────────────────────────────────────────────────────────
    print("\n" + "=" * 108)
    print("SIDE BY SIDE")
    print("=" * 108)

    header = (f"{'CLAIM':<9} | {'v1 amount':<14} {'type':<7} {'v1 sev':<9} "
              f"{'v1 decision':<14} | {'v2 amount':<11} {'v2 sev':<9} "
              f"{'v2 decision':<14} |")
    print(header)
    print("-" * 108)

    for r in rows:
        flag = "  <-- DIFFERS" if r["differs"] else ""
        print(
            f"{r['id']:<9} | {truncate(r['v1_amt'], 14):<14} {r['v1_type']:<7} "
            f"{truncate(r['v1_sev'], 9):<9} {truncate(r['v1_decision'], 14):<14} | "
            f"{truncate(r['v2_amt'], 11):<11} {truncate(r['v2_sev'], 9):<9} "
            f"{truncate(r['v2_decision'], 14):<14} |{flag}"
        )

    # ── summary ──────────────────────────────────────────────────────
    print("\n" + "=" * 108)
    print("SUMMARY")
    print("=" * 108)
    print(f"  claims run                            : {len(rows)}")
    print(f"  routing decisions that DISAGREE       : {disagreements}")
    print(f"  v1 amounts that were not numeric      : {v1_type_problems}")
    print(f"  v1 severities outside the four labels : {v1_severity_problems}")
    print()
    print("  Every disagreement is a claim one of the two agents sent to the")
    print("  wrong queue. Read the note for those claim ids and decide which")
    print("  agent was right - that judgement is the whole exercise.")
    print()


if __name__ == "__main__":
    main()


