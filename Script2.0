    #             if name:
    #                 exclusions_list.append(name)
    # # Fallback ONLY if Guidewire did not provide a coverage limit
    # if coverage_limit is None:
    #     log.warning(
    #         "Guidewire did not return a coverage limit for policy %s. Using default PoC value 500000.",
    #         policy_number,
